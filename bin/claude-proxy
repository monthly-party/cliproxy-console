#!/usr/bin/env bash
# Claude Code through the proxy: every request uses one of the pooled accounts.
set -euo pipefail
source "$(dirname "$(readlink -f "$0")")/_config.sh"
official_cli="$(real_cli claude)"
case "${1:-}" in --version|-v|--help|-h) exec "$official_cli" "$@";; esac
load_client_key
export ANTHROPIC_BASE_URL="http://127.0.0.1:$PROXY_PORT"
export ANTHROPIC_AUTH_TOKEN="$CLIPROXYAPI_CLIENT_KEY"
export CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY=1
# A direct key or OAuth token would bypass the proxy.
unset ANTHROPIC_API_KEY CLAUDE_CODE_OAUTH_TOKEN
exec "$official_cli" "$@"
