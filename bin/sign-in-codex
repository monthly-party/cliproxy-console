#!/usr/bin/env bash
# Add a Codex (ChatGPT) account to the proxy with the device-code flow.
set -euo pipefail
umask 077
source "$(dirname "$(readlink -f "$0")")/_config.sh"
if [[ ! -t 0 ]]; then
  echo "Run this sign-in in your own interactive terminal; never paste authentication data into a chat." >&2
  exit 78
fi
printf '%s\n' 'Sign in to the Codex account you want to add, using the device code shown below.' \
  'For another account, run this again with a different browser profile or after signing out.'
exec env -i HOME="$CLIPROXY_HOME/home" PATH=/usr/bin:/bin XDG_CONFIG_HOME="$CLIPROXY_HOME/home/.config" \
  "$PROXY_BINARY" -config "$PROXY_CONFIG" -codex-device-login -no-browser
