#!/usr/bin/env bash
# Codex CLI through the proxy, as a custom model provider.
set -euo pipefail
source "$(dirname "$(readlink -f "$0")")/_config.sh"
official_cli="$(real_cli codex)"
case "${1:-}" in --version|-V|--help|-h) exec "$official_cli" "$@";; esac
load_client_key
base="http://127.0.0.1:$PROXY_PORT/v1"
exec "$official_cli" "$@" \
  -c 'model_provider="cliproxy"' \
  -c 'model_providers.cliproxy.name="CLIProxyAPI"' \
  -c "model_providers.cliproxy.base_url=\"$base\"" \
  -c "model_providers.cliproxy.model_catalog_url=\"$base/models\"" \
  -c 'model_providers.cliproxy.wire_api="responses"' \
  -c 'model_providers.cliproxy.env_key="CLIPROXYAPI_CLIENT_KEY"' \
  -c 'model_providers.cliproxy.requires_openai_auth=false' \
  -c 'model_providers.cliproxy.supports_websockets=false' \
  -c 'features.api_key_model_discovery=true'
