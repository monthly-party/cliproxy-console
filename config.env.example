# cliproxy-console settings. Copy to ~/.config/cliproxy-console/config.env and edit.
# That file is read by scripts/deploy.py, the bin/ wrappers and the readiness probe.
# Keep it out of git: it names your machine and your login.

# Install directory of the proxy. Holds secrets (private/, auth/), logs and the console's
# runtime data. Never put this directory under version control.
CLIPROXY_HOME="$HOME/.local/share/cliproxy"

# Proxy (CLIProxyAPI) as configured in its config.yaml (server.port).
PROXY_PORT=8317
PROXY_BINARY="$CLIPROXY_HOME/bin/cli-proxy-api"
PROXY_CONFIG="$CLIPROXY_HOME/private/config.yaml"
# The proxy's stdout/stderr log. The console tails it to show live routing.
PROXY_LOG="$CLIPROXY_HOME/logs/proxy.log"
MANAGEMENT_KEY_FILE="$CLIPROXY_HOME/private/management-key"
CLIENT_KEY_FILE="$CLIPROXY_HOME/private/client-key"

# Console (this project). CONSOLE_DIR receives gateway/ on deploy and keeps usage.db there.
CONSOLE_DIR="$CLIPROXY_HOME/console"
CONSOLE_PORT=8318
# Quota snapshot shared with the proxy's weekly-reset routing (proxy/overlay). Without the
# overlay it is only used by the console.
QUOTA_SNAPSHOT="$CLIPROXY_HOME/console/quota-snapshot.json"
BACKUP_DIR="$CLIPROXY_HOME/backups"

# Tailscale Serve in front of the console: the https origin it is served on, and the one
# Tailscale login allowed in (sent by Serve as Tailscale-User-Login).
CONSOLE_ORIGIN="https://your-machine.your-tailnet.ts.net:8444"
CONSOLE_OWNER="you@example.com"

# systemd --user units. Deploy restarts CONSOLE_UNIT only and refuses to finish if any
# PROTECTED_UNITS changed PID (space separated).
PROXY_UNIT="cliproxy.service"
CONSOLE_UNIT="cliproxy-console.service"
PROTECTED_UNITS="cliproxy.service"
